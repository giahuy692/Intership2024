
export class DTOHRManpowerDetail {
    Code: number = 0;
    ManpowerMonth: number = 0; // Code định biên
    Department: number = 0; // Code đơn vị 
    Location: number = 0; // Code điểm làm việc
    Position: number = 0; // Code chức danh
    Quantity: number = 0; // Số lượng định biên
    CreatedBy: string = ''; // Người tạo
    CreatedTime: string = ''; // Ngày tạo
    LastModifiedTime: string = ''; // Thời gian chỉnh sửa cuối
    LastModifiedBy: string = ''; // Người chỉnh sửa
}

export class DTOHRManpowerDetailCus extends DTOHRManpowerDetail {
    ManpowerVersion: number = 0; // Phiên bản
    Month: number = 0; // Tháng
}